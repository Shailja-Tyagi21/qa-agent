# Copy to .env — never commit .env, never paste these into a report or a skill file.

# ── Jira (required) ──────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# ── GitLab (optional — enrichment only) ──────────────────────────────────────
GITLAB_API_URL=
GITLAB_TOKEN=

# ── Target environment (optional) ────────────────────────────────────────────
# For the public hackathon demo none of these are needed — michelinman.com is open.
# For an internal environment, set the base URL and basic-auth here ONLY.
QA_BASE_URL=
QA_BASIC_USER=
QA_BASIC_PASS=
