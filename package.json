{
  "name": "michelin-qa",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "description": "Playwright + Cucumber suite for public michelinman.com, with the qa-agent agent installed alongside it.",
  "scripts": {
    "test": "cucumber-js",
    "test:sanity": "cucumber-js --tags @sanity",
    "test:dealer": "cucumber-js --tags @dealer",
    "test:tire": "cucumber-js --tags @tire",
    "test:generated": "cucumber-js --profile generated",
    "index": "node scripts/suite-index.js",
    "doctor": "node scripts/doctor.js",
    "report": "node .github/skills/qa-agent/scripts/build-report.mjs",
    "test:all": "cucumber-js --profile all",
    "test:headless": "HEADLESS=1 cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.50.0",
    "playwright": "^1.50.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
