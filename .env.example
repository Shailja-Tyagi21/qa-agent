# Copy to .env — never commit it.
# The public demo against michelinman.com needs none of these except JIRA_*.

# ── Jira (required by the agent) ─────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# ── GitLab (optional — agent enrichment only) ────────────────────────────────
GITLAB_API_URL=
GITLAB_TOKEN=

# ── Target override (optional) ───────────────────────────────────────────────
# Defaults to https://www.michelinman.com when unset.
QA_BASE_URL=
QA_BASIC_USER=
QA_BASIC_PASS=
